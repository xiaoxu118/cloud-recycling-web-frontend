# 管理后台运行时配置模板
# 复制为 .env.development / .env.production 并修改实际值。
# 优先级：URL ?env=xxx > public/config.js > 这些构建时变量 > 代码内默认
# 详细说明见 README 「环境配置」一节。

# CloudBase / 微信云开发 环境 ID
# 务必与 miniprogram/app.js 里的 globalData.env 一致，否则 admin*_* 接口会落到不同环境。
VITE_CLOUDBASE_ENV=bangbang-d2gy4wqj264b5483c

# 云函数名（一般无需改）
VITE_FUNCTION_NAME=quickstartFunctions
